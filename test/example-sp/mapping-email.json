{
  "nameid_format": "emailAddress",
  "oidc_claim_mappings": {
    "sub": "subject",
    "email": "email",
    "name": "name"
  },
  "saml_attribute_mappings": {
    "subject": { "name": "uid" },
    "email": { "name": "mail", "friendly_name": "mail" },
    "name": { "name": "displayName", "friendly_name": "displayName" }
  },
  "options": {
    "lowercase_email": true
  }
}
